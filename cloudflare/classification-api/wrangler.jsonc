{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carteira-classificacao",
  "main": "src/index.js",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "assets": {
    "directory": "../../docs",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/banco/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carteira-classificacao",
      "database_id": "d10a8fe0-100b-484e-bd72-351696ddd321",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://jokasman.github.io",
    "ENABLE_BANKING_APP_ID": "aedb6c40-f89e-445c-bc96-25d72bffa4e6",
    "BANK_REDIRECT_URL": "https://carteira-classificacao.faint-foxtail.workers.dev/banco/callback"
  }
}
